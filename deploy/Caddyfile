# Edge proxy: automatic HTTPS (Let's Encrypt) for both domains.
#
#   {$DOMAIN}        client portal: /api /sanctum /up → Laravel, /app/* → Reverb, rest → Next.js
#   {$ADMIN_DOMAIN}  Super Admin + Horizon: everything → Laravel (/ redirects to /admin)
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{$DOMAIN} {
	import common

	request_body {
		max_size 110MB
	}

	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		reverse_proxy app:8000
	}

	@sockets path /app/*
	handle @sockets {
		reverse_proxy reverb:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

{$ADMIN_DOMAIN} {
	import common

	redir / /admin 302

	handle {
		reverse_proxy app:8000
	}
}
