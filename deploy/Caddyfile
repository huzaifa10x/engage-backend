# Edge proxy: automatic HTTPS (Let's Encrypt) for both domains.
#
#   {$DOMAIN}        client portal: /api /sanctum /up → Laravel, /app/* → Reverb, rest → Next.js
#   {$ADMIN_DOMAIN}  Super Admin + Horizon: everything → Laravel (/ redirects to /admin)
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# EXTRA_DOMAINS (optional, in deploy/.env) adds more hostnames that serve the same client portal,
# written with a leading comma: EXTRA_DOMAINS=", engage-web.10xdigital.ae". Used when the portal
# moves to a new domain, so the old one (and the Meta / Stripe webhooks still pointing at it) keeps
# working until everything has been switched over.
{$DOMAIN}{$EXTRA_DOMAINS:} {
	import common

	request_body {
		max_size 110MB
	}

	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		reverse_proxy app:8000
	}

	@sockets path /app/*
	handle @sockets {
		reverse_proxy reverb:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

{$ADMIN_DOMAIN} {
	import common

	redir / /admin 302

	handle {
		reverse_proxy app:8000
	}
}
