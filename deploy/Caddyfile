# Edge proxy (production stack): automatic HTTPS (Let's Encrypt) for every domain on the server.
#
#   {$DOMAIN}           client portal: /api /sanctum /up → Laravel, /app/* → Reverb, rest → Next.js
#   {$SITE_DOMAIN}      public marketing website → Next.js (engage-site)
#   {$ADMIN_DOMAIN}     Super Admin + Horizon: everything → Laravel (/ redirects to /admin)
#   {$STAGING_DOMAINS}  staging portal, admin and website → the staging stack's gateway
#                       (deploy/Caddyfile.staging), which routes them inside the staging stack
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# EXTRA_DOMAINS (optional, in deploy/.env) adds more hostnames that serve the same client portal,
# written with a leading comma: EXTRA_DOMAINS=", engage-web.10xdigital.ae". Used when the portal
# moves to a new domain, so the old one (and the Meta / Stripe webhooks still pointing at it) keeps
# working until everything has been switched over.
{$DOMAIN}{$EXTRA_DOMAINS:} {
	import common

	request_body {
		max_size 110MB
	}

	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		reverse_proxy app:8000
	}

	@sockets path /app/*
	handle @sockets {
		reverse_proxy reverb:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

# Public marketing website (engage-site). SITE_DOMAIN is set in deploy/.env once the site is live;
# until then Compose passes a placeholder name nobody can reach, so nothing changes.
{$SITE_DOMAIN} {
	import common

	handle {
		reverse_proxy site:3100
	}
}

# Old website addresses (e.g. engage-site.10xdigital.ae) → the website's real domain, permanently,
# so links and search rankings carry over. SITE_REDIRECT_DOMAINS in deploy/.env, comma separated.
{$SITE_REDIRECT_DOMAINS} {
	import common
	redir https://{$SITE_DOMAIN}{uri} 301
}

{$ADMIN_DOMAIN} {
	import common

	redir / /admin 302

	handle {
		reverse_proxy app:8000
	}
}

# Staging (separate stack, separate database). HTTPS ends here; the staging gateway does the
# routing. Until STAGING_DOMAINS is set in deploy/.env, Compose passes a placeholder name.
{$STAGING_DOMAINS} {
	import common

	request_body {
		max_size 110MB
	}

	reverse_proxy engage-staging-gateway:80
}
