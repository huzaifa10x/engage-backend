{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "paths": { "@/*": ["./resources/js/admin/*"] }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
