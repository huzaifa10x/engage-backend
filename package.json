{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "deploy:staging": "bash scripts/release.sh deploy staging",
        "deploy:production": "bash scripts/release.sh deploy production",
        "release:promote": "bash scripts/release.sh promote",
        "release:sync": "bash scripts/release.sh sync",
        "release:status": "bash scripts/release.sh status",
        "release:init": "bash scripts/release.sh init",
        "rollback:staging": "bash scripts/release.sh rollback staging",
        "rollback:production": "bash scripts/release.sh rollback production"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.0",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^7.0.0",
        "vite": "^8.3.0"
    }
}
