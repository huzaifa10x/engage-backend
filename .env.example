APP_NAME="10X Engage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Client (Next.js) + Super Admin
FRONTEND_URL=http://localhost:3000
ADMIN_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=null
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging — use "json" in containers/production
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL — the app role MUST NOT be SUPERUSER or BYPASSRLS (row-level security depends on it)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=engage
DB_USERNAME=engage
DB_PASSWORD=engage
DB_SSLMODE=prefer

# Valkey (Redis protocol) — cache, sessions, queues, locks
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=engage:

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Email (invitations, admin 2FA codes). Production: AWS SES over SMTP, e.g.
#   MAIL_MAILER=smtp  MAIL_HOST=<your SES SMTP endpoint>  MAIL_PORT=587  MAIL_USERNAME=…  MAIL_PASSWORD=…
# Port 587 upgrades to TLS automatically (STARTTLS). MAIL_FROM_ADDRESS must be on a domain verified in SES.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@engage.10xdigital.ae"
MAIL_FROM_NAME="${APP_NAME}"

HORIZON_PREFIX=engage-horizon:

# --- Meta / WhatsApp Cloud API (Tech Provider) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Coexistence (WhatsApp Business app numbers): the Embedded Signup configuration ID made for it.
# Setting the ID switches the feature on; META_COEXISTENCE_ENABLED=false switches it off again.
META_COEXISTENCE_CONFIG_ID=
META_COEXISTENCE_ENABLED=
# Onboarding is refused while the WhatsApp account is still subscribed to another provider's app.
# META_ALLOWED_OTHER_APP_IDS: comma-separated Meta app IDs that are tolerated (usually empty).
META_BLOCK_OTHER_SUBSCRIBED_APPS=true
# Also refuse numbers already connected by another 10X Engage environment using the same Meta app.
META_BLOCK_OTHER_ENVIRONMENTS=true
META_ALLOWED_OTHER_APP_IDS=
# Dedicated keyring for business tokens / PINs. Generate: php artisan engage:secrets:key
ENGAGE_SECRETS_KEYS=

# Where WhatsApp media is stored (private). Use an S3-compatible disk in production.
ENGAGE_MEDIA_DISK=local

# --- Realtime (Laravel Reverb) --- generate with: php -r 'echo bin2hex(random_bytes(16));'
REVERB_APP_ID=engage
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where LARAVEL publishes events (server-to-server). Browsers use the client's NEXT_PUBLIC_REVERB_* instead.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost:3000,127.0.0.1:3000

# Stripe billing (Dashboard → Developers → API keys / Webhooks). Webhook URL: https://<api-domain>/api/webhooks/stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Optional: an existing 5% exclusive UAE VAT tax rate (txr_...). Left empty, one is created automatically.
STRIPE_UAE_TAX_RATE_ID=

# Super Admin panel: require two-factor authentication for every platform admin (recommended).
# Set to false to let admins turn 2FA off on their Security page.
ADMIN_2FA_REQUIRED=true

# Sign-in: email a one-time code after the password; a verified browser is trusted for 24 hours.
# Set to false only in an emergency (for example the mail server is down and nobody can sign in).
LOGIN_OTP_ENABLED=true

# Where demo / contact requests from the public website are emailed.
ENGAGE_SALES_EMAIL=

# Integrations → Shopify (app created in Shopify's Dev Dashboard). Leave empty to hide Shopify.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders
